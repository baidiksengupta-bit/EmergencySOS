# ==============================================================================
# EmergencySOS Backend Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="EmergencySOS Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated for React Native Expo development)
CORS_ORIGINS=["http://localhost:8081","http://localhost:19000","http://localhost:19006","*"]

# Database Configuration (SQLite default for local setup)
# For local SQLite: sqlite:///./emergency_sos.db
DATABASE_URL="sqlite:///./emergency_sos.db"

# Security & Secrets
SECRET_KEY="temporary-dev-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party Services (Optional in local development setup)
GOOGLE_MAPS_API_KEY=""
FIREBASE_CREDENTIALS_PATH=""
